# =============================================================================
# Execora — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Required variables are marked [REQUIRED].
# Optional variables have sensible defaults.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# -----------------------------------------------------------------------------
# Database [REQUIRED]
# PostgreSQL connection string
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://execora:execora@localhost:5432/execora?schema=public

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=           # Uncomment if Redis requires a password

# -----------------------------------------------------------------------------
# MinIO (S3-compatible object storage)
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=execora
MINIO_USE_SSL=false

# -----------------------------------------------------------------------------
# OpenAI [REQUIRED for voice commands]
# Get your key at https://platform.openai.com/api-keys
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# -----------------------------------------------------------------------------
# Speech-to-Text (STT)
# Supported providers: deepgram | elevenlabs
# -----------------------------------------------------------------------------
STT_PROVIDER=deepgram

# Deepgram — https://console.deepgram.com
DEEPGRAM_API_KEY=your-deepgram-api-key-here

# ElevenLabs STT (alternative)
# ELEVENLABS_STT_MODEL=scribe_v2
# ELEVENLABS_STT_REALTIME_MODEL=scribe_v2_realtime
# ELEVENLABS_STT_LANGUAGE=         # e.g. hi (Hindi), en (English)

# -----------------------------------------------------------------------------
# Text-to-Speech (TTS)
# Supported providers: elevenlabs | openai
# -----------------------------------------------------------------------------
TTS_PROVIDER=elevenlabs

# ElevenLabs — https://elevenlabs.io
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# -----------------------------------------------------------------------------
# WhatsApp Business API (optional — for payment reminders)
# Get credentials at https://developers.facebook.com/docs/whatsapp
# -----------------------------------------------------------------------------
# WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# WHATSAPP_ACCESS_TOKEN=your-access-token
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=any-random-secret-string
# WHATSAPP_API_VERSION=v18.0

# -----------------------------------------------------------------------------
# Email / SMTP (optional — for OTP-based data deletion)
# -----------------------------------------------------------------------------
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=you@gmail.com
# EMAIL_PASS=your-app-password
# EMAIL_FROM="Execora Support <support@execora.local>"

# -----------------------------------------------------------------------------
# Timezone
# -----------------------------------------------------------------------------
TZ=Asia/Kolkata

# -----------------------------------------------------------------------------
# CORS (comma-separated allowed origins)
# Leave empty to allow all origins in development
# -----------------------------------------------------------------------------
# ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# -----------------------------------------------------------------------------
# Logging
# Levels: fatal | error | warn | info | debug | trace
# -----------------------------------------------------------------------------
LOG_LEVEL=info
